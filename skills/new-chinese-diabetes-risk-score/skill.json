  "population": {
    "age_years": [
      20,
      74
    ],
    "note_zh": "中国未确诊糖尿病成人；推导为全国横断面调查，外部验证限青岛35–74岁人群；已确诊者不计算。"
  },
  "inputs_status": "verified",
  "inputs": [
