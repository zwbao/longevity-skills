  "topic": [
    "body_weight_metabolism",
    "screening_prevention"
  ],
  "blurb_zh": "用年龄、性别、腰围、BMI、收缩压和家族史计算糖尿病筛查分数。",
  "intents": [
    "lab_meaning",
    "body_fat_waist"
  ],
  "triage": {
    "reason_zh": "正文表2完整印出六项个人指标的分档权重，正文给出筛查阈值，可逐项复现并计算个人筛查分层。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.2337/dc13-0593",
    "title": "Nonlaboratory-Based Risk Assessment Algorithm for Undiagnosed Type 2 Diabetes Developed on a Nation-Wide Diabetes Survey",
    "title_zh": "新中国糖尿病风险评分",
    "journal": "Diabetes Care",
    "year": 2013,
    "authors": "Zhou 等",
    "article_url": "https://diabetesjournals.org/care/article/36/12/3944/33144",
    "supplements": [
      {
        "label": "Supplementary Data（链接受限，未取得，计算未使用）",
        "url": "https://care.diabetesjournals.org/lookup/suppl/doi:10.2337/dc13-0593/-/DC1"
      }
    ],
    "card_notes": [
      "计算采用正文表2的整数Score列和正文的筛查阈值；逐项分数已复现，不表示复现了队列验证。",
      "全文由CDC公开存档核对；补充材料链接返回403，未取得其文件或内容。",
      "本技能不把青岛三年随访的群体表现换算成个人三年发病概率。"
    ],
    "summary_zh": "这项研究在中国成人中建立了无需化验的糖尿病筛查评分，并在青岛人群中验证了识别未诊断糖尿病和区分后续发病者的能力。个人报告只计算六项资料的总分、逐项得分和筛查分层，以及使用者所给目标对应的分数变化，不计算个人发病概率。",
    "summary_status": "draft"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
