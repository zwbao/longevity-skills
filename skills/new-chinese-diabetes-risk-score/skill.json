        1
      ],
      "required": true,
      "from": "argument",
      "flag": "--sex",
      "note_zh": "命令行 male/female 或 男/女，对应论文 Men/Women；内部编码男1、女0。"
    },
    {
      "key": "waist_cm",
      "label_zh": "腰围",
      "aliases": [
        "waist",
        "WC",
        "waist circumference",
        "腹围"
      ],
      "unit": "cm",
      "accept": {
        "m": 100,
        "mm": 0.1,
        "in": 2.54
      },
      "unit_required": true,
      "range": [
        40,
        200
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "下肋缘与髂嵴之间中点处测量；不是裤子尺码。"
    },
    {
      "key": "bmi_kg_m2",
      "label_zh": "体质指数",
      "aliases": [
        "BMI",
        "body mass index",
        "身体质量指数"
      ],
      "unit": "kg/m^2",
      "range": [
        10,
        70
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "体重kg除以身高m的平方。"
    },
    {
      "key": "sbp_mmhg",
      "label_zh": "收缩压",
      "aliases": [
        "SBP",
        "systolic blood pressure",
        "高压"
      ],
      "unit": "mmHg",
      "accept": {
        "kPa": 7.500617
      },
      "range": [
        60,
        260
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "使用测量均值；论文推导组取两次、验证组取三次血压测量的均值。"
    },
    {
      "key": "family_history",
      "label_zh": "一级亲属糖尿病史",
      "aliases": [
        "family history of diabetes",
        "糖尿病家族史",
        "diabetes family history"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "父母、兄弟姐妹或子女有糖尿病填1，无填0；未知不当作无。"
    },
    {
      "key": "known_diabetes",
      "label_zh": "已经确诊糖尿病",
      "aliases": [
        "known diabetes",
        "既往糖尿病诊断"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "argument",
      "flag": "--known-diabetes",
      "note_zh": "yes/no 或 是/否；适用性核对，不加减评分。yes时退出3。"
    }
  ],
