  "blurb_zh": "用25项血浆蛋白和性别计算仍在验证的MitoAge线粒体相关分值，不是年龄岁数。",
  "intents": [
    "proteomic_organ_age"
  ],
  "triage": {
    "reason_zh": "人体血浆蛋白的25个权重、截距和男性系数均公开，可计算个人线性分值；无完整个人算例，标为draft。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1038/s41514-026-00449-8",
    "title": "The blood proteome predicts the impact of circulating factors on age-related mitochondrial health",
    "title_zh": "血液蛋白预测循环因子对年龄相关线粒体健康的影响",
    "journal": "npj Aging",
    "year": 2026,
    "authors": "Heimler 等",
