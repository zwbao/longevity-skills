  "blurb_zh": "用个人基因型剂量计算五种常见病的原始多基因加权分数，要求位点齐全，不换算患病概率。",
  "intents": [
    "gene_variant"
  ],
  "triage": {
    "reason_zh": "原创人体研究公开五种疾病全部逐变异权重，可由个人基因型剂量加权求和；未发现个人输入与总分配对示例，保留为待验证版本。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1038/s41588-018-0183-z",
    "title": "Genome-wide polygenic scores for common diseases identify individuals with risk equivalent to monogenic mutations.",
    "title_zh": "常见病全基因组多基因评分识别风险接近单基因突变的个体",
    "journal": "Nature Genetics",
    "year": 2018,
    "authors": "Khera 等",
    "article_url": "https://www.nature.com/articles/s41588-018-0183-z",
    "supplements": [
      {
        "label": "Supplementary Figures 1–3 / Tables 1–10",
        "url": "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0183-z/MediaObjects/41588_2018_183_MOESM1_ESM.pdf"
      },
      {
        "label": "Life Sciences Reporting Summary",
        "url": "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0183-z/MediaObjects/41588_2018_183_MOESM2_ESM.pdf"
