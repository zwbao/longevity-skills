  "blurb_zh": "用血压及重复记录标准差、体质指数、血脂比值和病史估计十年心血管病风险；需英国Townsend评分，仍在验证。",
  "intents": [
    "frailty_mortality",
    "lab_meaning"
  ],
  "triage": {
    "reason_zh": "人体队列公开男女完整模型C系数，可计算个人十年心血管风险；印出的个人示例缺Townsend评分，暂作草稿。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1136/bmj.j2099",
    "title": "Development and validation of QRISK3 risk prediction algorithms to estimate future risk of cardiovascular disease: prospective cohort study.",
    "title_zh": "QRISK3：未来心血管病风险预测算法的开发与验证",
    "journal": "BMJ (Clinical research ed.)",
    "year": 2017,
    "authors": "Hippisley-Cox 等",
    "article_url": "https://www.bmj.com/content/357/bmj.j2099",
