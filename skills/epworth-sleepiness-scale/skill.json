  "paper": {
    "doi": "10.1093/sleep/14.6.540",
    "title": "A new method for measuring daytime sleepiness: the Epworth sleepiness scale.",
    "title_zh": "测量日间嗜睡的新方法：Epworth嗜睡量表",
    "journal": "Sleep",
    "year": 1991,
    "authors": "Johns",
