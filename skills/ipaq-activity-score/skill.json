    "before_after"
  ],
  "triage": {
    "reason_zh": "人体多国测量验证论文表1及方法印出短表分强度与步行速度的权重和时长×天数×MET求和算法，可用个人问卷计算；未印个人总分算例，保留draft。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1249/01.mss.0000078924.61453.fb",
    "title": "International physical activity questionnaire: 12-country reliability and validity.",
    "title_zh": "国际体力活动问卷：十二国信度与效度研究",
    "journal": "Medicine and Science in Sports and Exercise",
    "year": 2003,
    "authors": "Craig 等",
    "article_url": "https://journals.lww.com/acsm-msse/fulltext/2003/08000/international_physical_activity_questionnaire_.20.aspx",
    "supplements": [
