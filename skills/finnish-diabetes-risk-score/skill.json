{
  "schema": "longevity-skill/1",
  "name": "finnish-diabetes-risk-score",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "cohort",
  "domains": [
    "代谢与心血管"
  ],
  "topic": [
    "body_weight_metabolism",
    "screening_prevention"
  ],
  "blurb_zh": "用年龄、腰围、BMI和四项问卷计算原版七项糖尿病风险筛查分数。",
  "intents": [
    "lab_meaning",
    "body_fat_waist",
    "before_after"
  ],
  "triage": {
    "reason_zh": "人群前瞻开发及独立验证的七项筛查评分，表1逐项分值和正文切点齐全，可计算个人总分并复现印出的分值。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.2337/diacare.26.3.725",
    "title": "The diabetes risk score: a practical tool to predict type 2 diabetes risk.",
    "title_zh": "糖尿病风险评分：预测2型糖尿病风险的实用工具",
    "journal": "Diabetes Care",
    "year": 2003,
    "authors": "Lindström 与 Tuomilehto",
    "article_url": "https://diabetesjournals.org/care/article/26/3/725/29197/The-Diabetes-Risk-ScoreA-practical-tool-to-predict",
    "supplements": [],
    "card_notes": [
      "使用2003年原版七项评分；家族史扩展不属于本技能。已复现表1逐项得分，不代表重新验证队列预测性能。",
      "原版已发表PDF全文经公开副本核对；出版社网页被访问验证拦截。全文未点名补充文件或公开代码，Europe PMC标记hasSuppl=N，详见来源记录。"
    ],
    "summary_zh": "这项研究在芬兰成年人中开发并前瞻验证了以体型、年龄和问卷识别未来接受糖尿病药物治疗者的简易风险评分。个人报告只计算原版逐项得分、总分、筛查切点及用户提供目标下的分数变化，不计算个人患病概率或干预收益。",
    "summary_status": "draft"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
    ],
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true,
    "targets_flag": "--targets",
    "levers_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "bmi_kg_m2",
      "label_zh": "体质指数",
      "aliases": [
        "BMI",
        "body mass index",
        "体重指数"
      ],
      "unit": "kg/m^2",
      "range": [
        10,
        80
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "按体重kg除以身高m的平方计算；原版BMI>25至30记1分，>30记3分。"
    },
    {
      "key": "waist_cm",
      "label_zh": "腰围",
      "aliases": [
        "waist",
        "waist circumference",
        "WC"
      ],
      "unit": "cm",
      "range": [
        40,
        200
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "最低肋骨与髂嵴之间的中点测量；男性和女性使用原文不同阈值。",
      "accept": {
        "m": 100,
        "mm": 0.1,
        "in": 2.54
      }
    },
    {
      "key": "bp_medication_ever",
      "label_zh": "曾用降压药",
      "aliases": [
        "ever used blood pressure medication",
        "history of antihypertensive drug treatment",
        "降压药使用史"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "0=从未，1=曾经；不是仅问现在是否服药，不能通过停药改变此病史。"
    },
    {
      "key": "high_glucose_history",
      "label_zh": "血糖升高史",
      "aliases": [
        "history of high blood glucose",
        "高血糖史"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "0=无，1=曾由医务人员告知糖尿病或潜在糖尿病，含暂时/临界血糖升高、妊娠糖尿病和仅饮食治疗的糖尿病；不是本次血糖数值。"
    },
    {
      "key": "low_activity",
      "label_zh": "原文低活动类别",
      "aliases": [
        "physical inactivity",
        "低体力活动",
        "low physical activity"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "1=闲暇以阅读、看电视及不费力家务为主、活动不足4小时/周且工作以坐位为主无需多走动；0=不符合该低活动类别。恰4小时按表1脚注的至少4小时类别记0；不要替换为后来的每日30分钟问题。"
    },
    {
      "key": "daily_produce",
      "label_zh": "每天吃蔬菜水果或浆果",
      "aliases": [
        "daily vegetables fruits or berries",
        "daily consumption of vegetables fruits or berries",
        "每日蔬果"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "1=每天吃至少其中一类，0=不是每天吃；按第727页正文每天吃记0分。"
    },
    {
      "key": "antidiabetic_treatment",
      "label_zh": "评估时接受降糖药治疗",
      "aliases": [
        "antidiabetic drug treatment",
        "降糖药治疗"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "0=否，1=是；仅作适用性检查，1时停止，不计入七项得分。"
    },
    {
      "key": "age",
      "label_zh": "实足年龄",
      "aliases": [
        "年龄",
        "age years"
      ],
      "unit": "a",
      "range": [
        35,
        64
      ],
      "required": true,
      "from": "profile",
      "note_zh": "填写已满周岁整数；不向研究年龄范围外推。",
      "flag": "--age"
    },
    {
      "key": "sex",
      "label_zh": "性别",
      "aliases": [
        "sex",
        "性别"
      ],
      "required": true,
      "from": "profile",
      "flag": "--sex",
      "note_zh": "male/男或female/女，只用于原文腰围阈值，不另加性别分。"
    }
  ],
  "outputs": [
    {
      "key": "age_score",
      "label_zh": "年龄得分",
      "unit": "score"
    },
    {
      "key": "bmi_score",
      "label_zh": "BMI得分",
      "unit": "score"
    },
    {
      "key": "waist_score",
      "label_zh": "腰围得分",
      "unit": "score"
    },
    {
      "key": "bp_medication_score",
      "label_zh": "曾用降压药得分",
      "unit": "score"
    },
    {
      "key": "high_glucose_score",
      "label_zh": "血糖升高史得分",
      "unit": "score"
    },
    {
      "key": "activity_score",
      "label_zh": "活动得分",
      "unit": "score"
    },
    {
      "key": "produce_score",
      "label_zh": "蔬果得分",
      "unit": "score"
    },
    {
      "key": "total_score",
      "label_zh": "原版糖尿病风险总分",
      "unit": "score"
    },
    {
      "key": "cutoff_category",
      "label_zh": "是否达到原文筛查切点",
      "note_zh": "below_cutoff为<9分；at_or_above_cutoff为≥9分；不是诊断或个人概率。"
    }
  ],
  "validation": {
    "status": "reproduced",
    "examples": [
      {
        "locator": "Table 1, p. 726: Age (years) and BMI rows, category / full-model coefficient / Score cells",
        "quote": "45–54 0.650 2; 55–64 0.940 3; >25 to 30 0.015 1",
        "values": [
          2,
          3,
          1
        ],
        "tolerance": "整数分值精确相等；测试使用原文年龄区间端点45、54、55、64及BMI上端点30。仅复现逐项分值，不声称复现个体预测概率。",
        "test": "tests/test_manifest.py::test_table1_printed_age_bmi_scores"
      }
    ]
  }
}
