{
  "schema": "longevity-skill/1",
  "name": "physical-activity-frailty-index",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "cross_sectional",
  "domains": [
    "衰弱与运动"
  ],
  "blurb_zh": "用每周高、中、低强度活动分钟数算论文的加权总活动量并分档，用 48 项问卷和四项化验算衰弱指数，再查回中国老人队列里该档的衰弱分数差和 10 年死亡风险比。",
  "intents": [
    "frailty_mortality"
  ],
  "triage": {
    "reason_zh": "论文印出总活动量公式、0/1–149/150–299/≥300 分钟分档、48 项衰弱指数清单和计分、各分档的 β 与风险比，个人问卷和体检可算；论文没印个人算例，验证保持草稿。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1007/s11357-026-02480-9",
    "title": "Dose–response effects of physical activity intensity and duration on frailty phenotype, frailty index, and survival: representative evidence from a 10-year national cohort of chinese older adults",
    "title_zh": "体力活动强度与时长对衰弱表型、衰弱指数和生存的剂量反应关系：来自中国老人 10 年全国队列的代表性证据",
    "journal": "GeroScience",
    "year": 2026,
    "authors": "Ji",
    "article_url": "https://link.springer.com/article/10.1007/s11357-026-02480-9",
    "supplements": [
      {
        "label": "Supplementary file 1（补充表 1、2：Cox 风险比）",
        "url": "https://static-content.springer.com/esm/art%3A10.1007%2Fs11357-026-02480-9/MediaObjects/11357_2026_2480_MOESM1_ESM.docx"
      }
    ],
    "card_notes": [
      "数据来自中国健康与养老追踪调查（CHARLS）2011 年基线的 60 岁及以上老人，随访到 2020 年；衰弱表型分析 2231 人（随访中 859 人死亡），衰弱指数分析 2330 人（正文另一处写 2230 人，903 人死亡）。",
      "总活动量 = 2×高强度 + 中等强度 + 0.5×低强度（分钟/周），作者说明这是按强度加权的近似，不是正式的 MET 分钟。分档 0、1–149、150–299、≥300 分钟/周；≥150 分钟/周算达到 WHO 指南。",
      "衰弱指数 = 表 2 的 48 项缺陷分之和 ÷ 48；≤0.10 健康，0.10–0.21 衰弱前期，>0.21 衰弱。衰弱表型 5 项里握力、步速、体力活动按队列内性别最低 20% 计分，论文没印出这些切点。",
      "β 来自线性回归（调整年龄、性别、婚姻、教育、居住地，模型 3 再加吸烟、饮酒）；风险比来自 Cox 模型，补充表 1 的 F 组与 B 组、补充表 2 的 G 组与 C 组数值完全相同，原文如此。"
    ],
    "summary_zh": "这项研究用中国健康与养老追踪调查的 60 岁及以上老人数据发现，每周体力活动越多，衰弱表型分数和衰弱指数越低，活动多的人 10 年全因死亡风险也较低，但这些是观察到的关联，不能证明因果。个人报告只按论文公式算你的加权总活动量和分档、用 48 项问卷和化验算衰弱指数、算出衰弱表型里能算的两项，并查回该分档在论文人群里的分数差和风险比，不估算个人死亡概率，也不做诊断。",
    "summary_status": "draft"
  },
