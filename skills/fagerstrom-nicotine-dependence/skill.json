    "before_after"
  ],
  "triage": {
    "reason_zh": "人群量表修订研究的表3完整印出六题选项及计分，个人回答可计算总分，测试复现逐项印刷分值。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1111/j.1360-0443.1991.tb01879.x",
    "title": "The Fagerström Test for Nicotine Dependence: a revision of the Fagerström Tolerance Questionnaire.",
    "title_zh": "Fagerström尼古丁依赖测试：对耐受问卷的修订",
    "journal": "British journal of addiction",
    "year": 1991,
    "authors": "Heatherton 等",
    "article_url": "https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1360-0443.1991.tb01879.x",
    "supplements": [],
    "card_notes": [
      "计算依据为正文表3（第1125页）。全文公开副本：https://cpb-us-e1.wpmucdn.com/sites.dartmouth.edu/dist/4/869/files/2010/10/91_Heatherton_etal_BJA.pdf",
      "原文表3有非研究用途需向K. O. Fagerström取得许可的说明；本实现不声称已取得该许可。"
    ],
    "summary_zh": "这项研究发现，人类吸烟者问卷中删去尼古丁标示量和吸入方式问题、细化晨起吸烟时间与每日支数计分，可以改善对吸烟依赖表现的测量。个人报告只计算自报问卷的逐题分数和总分，不估计戒烟成功率、疾病风险或寿命。",
    "summary_status": "draft"
  },
