    },
    {
      "key": "percentile_upper",
      "label_zh": "上方参考百分位",
      "unit": "%",
      "note_zh": "高于P95时为null；不是置信区间。"
    },
    {
      "key": "reference_median_ml_kg_min",
      "label_zh": "本组参考中位数",
      "unit": "mL/kg/min"
    }
  ],
