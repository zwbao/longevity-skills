  "evidence": "method",
  "domains": [
    "生活方式与健康风险"
  ],
  "blurb_zh": "把自己的平均每日纯酒精摄入量与按年龄、性别、地区和历史年份分层的 GBD 人群阈值比较，显示差值及所在侧，不给安全饮酒量。",
  "intents": [
    "intervention_evidence"
  ],
  "triage": {
    "reason_zh": "更正版附录 2 表 S1 印出各分层 TMREL 与 NDE；个人摄入量可按正文标准杯定义换算并与阈值比较。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1016/s0140-6736(22)00847-9",
    "title": "Population-level risks of alcohol consumption by amount, geography, age, sex, and year: a systematic analysis for the Global Burden of Disease Study 2020.",
    "title_zh": "按饮酒量、地区、年龄、性别及年份分析人群饮酒风险：全球疾病负担研究",
    "journal": "Lancet (London, England)",
    "year": 2022,
    "authors": "GBD 2020 Alcohol Collaborators",
    "article_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9289789/",
    "supplements": [
      {
        "label": "附录 1：方法、地区映射、敏感性分析及 GATHER 清单（更正版）",
        "url": "https://ars.els-cdn.com/content/image/1-s2.0-S0140673622008479-mmc1.pdf"
      },
      {
        "label": "附录 2：表 S1 TMREL/NDE、图 S1–S5、表 S2–S3（更正版）",
        "url": "https://ars.els-cdn.com/content/image/1-s2.0-S0140673622008479-mmc2.pdf"
      }
    ],
    "card_notes": [
      "使用 2022 年 7 月 19 日更正的附录 2 表 S1；输入参考年份默认 2020，不代表当前年份的估计。",
      "全部 21 个 GBD 地区、1990/2000/2010/2020 四年、15–79 岁五岁档及 80 plus 合并档；男女分列。每标准杯为 10 g 纯乙醇。",
      "技能读取已发表阈值，不重建疾病负担加权风险曲线；附录的旧代码入口现跳转 IHME 数据访问说明，正文的特定分析数据注明需联系作者。"
    ],
    "summary_zh": "这项研究通过整合人类观察性研究与疾病负担数据，发现饮酒相关综合风险的人群阈值随年龄和地区而变化，年轻人的阈值较低。个人报告只比较自己的平均每日纯酒精摄入量与对应历史人群阈值的差值及所在侧，不估算个人患病概率、寿命或饮酒收益。",
    "summary_status": "draft"
  },
