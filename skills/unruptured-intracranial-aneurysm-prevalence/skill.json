    },
    {
      "key": "hypertension_rr",
      "label_zh": "高血压相对无高血压的风险比（仅高血压者）",
      "unit": ""
    },
    {
      "key": "country_prevalence_pct",
      "label_zh": "所在国家健康人研究的患病率",
      "unit": "%"
    },
    {
      "key": "country_pr_age_sex",
      "label_zh": "所在国家相对美国的患病率比（校正年龄和性别）",
      "unit": ""
    }
  ],
