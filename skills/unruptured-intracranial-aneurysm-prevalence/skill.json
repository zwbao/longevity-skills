{
  "schema": "longevity-skill/1",
  "name": "unruptured-intracranial-aneurysm-prevalence",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "review",
  "domains": [
    "脑、认知与痴呆",
    "影像"
  ],
  "blurb_zh": "按年龄、性别、多囊肾、家族史、吸烟和高血压，查你这类人里脑动脉瘤（未破裂颅内动脉瘤）有多常见。",
  "intents": [
    "imaging"
  ],
  "triage": {
    "reason_zh": "全文和附录印出参考人群患病率 3.9%、年龄两档、男女、四类合并病、吸烟、高血压和八国的患病率与比值；个人按这些印出的切点和分组落档，读出对应患病率。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1016/s1474-4422(26)00276-0",
    "title": "Prevalence of unruptured intracranial aneurysms according to comorbidities, risk factors, country, and time period: a systematic review and meta-analysis",
    "title_zh": "未破裂颅内动脉瘤患病率：按合并病、危险因素、国家和年代的系统综述与荟萃分析",
    "journal": "The Lancet Neurology",
    "year": 2026,
    "authors": "Dremel 等",
    "article_url": "https://doi.org/10.1016/S1474-4422(26)00276-0",
    "supplements": [
      {
        "label": "Supplementary appendix（mmc1，40 页）",
        "url": "https://ars.els-cdn.com/content/image/1-s2.0-S1474442226002760-mmc1.pdf"
      },
      {
        "label": "乌得勒支大学机构库全文（出版社版本）",
        "url": "https://dspace.library.uu.nl/handle/1874/491254"
      }
    ],
    "card_notes": [
      "论文汇总 162 项研究，按组分别给出患病率和比值，没有把年龄、性别、合并病、吸烟、高血压放进同一个模型，也没有印出模型系数；报告只把你落进各组并照抄各组的数，几项比值不相乘。",
      "年龄两档（55 岁以下、以上）是按研究人群的平均年龄分的，不是按个人年龄；每多一岁的相对变化印作“1·06%（95% CI 1·03–1·09）”，记法有歧义，没有用来换算。",
      "附录表 6 里荷兰的置信区间印作“01·0-1·5”，包不住点估计 2·1%，报告不引用这一区间。"
    ],
    "summary_zh": "这项研究汇总了几十年来各国对成人做脑血管影像或尸检的研究，发现未破裂颅内动脉瘤在女性、现在吸烟者、高血压者，以及多囊肾病、结缔组织病和有家族史的人里更常见，而且近二十年的研究里比例在上升。个人报告只按你的年龄、性别、合并病、吸烟、高血压和国家，找出论文里对应的人群并照抄其患病率和比值，不把几项相乘成你个人的概率，也不判断你有没有动脉瘤。",
    "summary_status": "draft"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "age",
      "label_zh": "实足年龄",
      "unit": "a",
      "range": [
        18,
        110
      ],
      "required": true,
      "from": "profile",
      "flag": "--age",
      "note_zh": "论文按研究人群平均年龄在 55 岁处分两档；55 岁整按 55 岁以上算。"
    },
    {
      "key": "sex",
      "label_zh": "性别",
      "required": true,
      "from": "profile",
      "flag": "--sex"
    },
    {
      "key": "adpkd",
      "label_zh": "是否有常染色体显性多囊肾病（ADPKD）",
      "aliases": [
        "多囊肾",
        "多囊肾病",
        "polycystic kidney disease",
        "ADPKD"
      ],
      "required": true,
      "from": "argument",
      "flag": "--adpkd",
      "note_zh": "yes 或 no。"
    },
    {
      "key": "connective_tissue",
      "label_zh": "是否有结缔组织病（马方、埃勒斯-当洛斯、Loeys-Dietz 综合征）",
      "aliases": [
        "马方综合征",
        "Marfan",
        "Ehlers-Danlos",
        "Loeys-Dietz",
        "结缔组织病"
      ],
      "required": true,
      "from": "argument",
      "flag": "--connective-tissue",
      "note_zh": "yes 或 no。论文把这三种综合征合并成一组。"
    },
    {
      "key": "family_history",
      "label_zh": "一级亲属里有几位得过颅内动脉瘤或动脉瘤破裂出血（动脉瘤性蛛网膜下腔出血）",
      "aliases": [
        "家族史",
        "family history",
        "颅内动脉瘤家族史"
      ],
      "required": true,
      "from": "argument",
      "flag": "--family-history",
      "note_zh": "no、1 或 2+；只知道有、不知道几位时写 yes。"
    },
    {
      "key": "atherosclerosis",
      "label_zh": "是否有动脉粥样硬化相关病（颈动脉狭窄、缺血性卒中、冠心病等）",
      "aliases": [
        "动脉粥样硬化",
        "颈动脉狭窄",
        "缺血性卒中",
        "冠心病",
        "atherosclerosis"
      ],
      "required": true,
      "from": "argument",
      "flag": "--atherosclerosis",
      "note_zh": "yes 或 no。论文把颈动脉狭窄、缺血性卒中、缺血性心脏病、冠状动脉扩张或夹层、胸主动脉或肾动脉瘤的研究归为这一组。"
    },
    {
      "key": "smoking",
      "label_zh": "吸烟情况",
      "aliases": [
        "吸烟",
        "smoking",
        "smoker"
      ],
      "required": true,
      "from": "argument",
      "flag": "--smoking",
      "note_zh": "current（现在吸）、former（已戒）或 never（从不吸）。"
    },
    {
      "key": "hypertension",
      "label_zh": "是否有高血压",
      "aliases": [
        "高血压",
        "hypertension"
      ],
      "required": true,
      "from": "argument",
      "flag": "--hypertension",
      "note_zh": "yes 或 no。在用降压药也算有。"
    },
    {
      "key": "country",
      "label_zh": "所在国家",
      "required": false,
      "from": "argument",
      "flag": "--country",
      "note_zh": "可选。附录表 6 单列了中国、日本、韩国、美国、芬兰、德国、荷兰、英国。"
    }
  ],
  "outputs": [
    {
      "key": "age_band",
      "label_zh": "年龄档（论文按 55 岁分）",
      "unit": ""
    },
    {
      "key": "age_band_prevalence_pct",
