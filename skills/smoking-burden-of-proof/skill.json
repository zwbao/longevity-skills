{
  "schema": "longevity-skill/1",
  "name": "smoking-burden-of-proof",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "method",
  "domains": [
    "吸烟与疾病风险"
  ],
  "topic": [
    "tobacco_alcohol"
  ],
  "blurb_zh": "按当前吸烟者的累计包年或每日支数，在论文印出的暴露点查相对风险与不确定区间。",
  "intents": [
    "intervention_evidence"
  ],
  "triage": {
    "reason_zh": "人群荟萃分析表2公开个人吸烟暴露对应的相对风险，支持限定暴露点和参考年龄组的精确查表。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1038/s41591-022-01978-x",
    "title": "Health effects associated with smoking: a Burden of Proof study",
    "title_zh": "吸烟相关健康效应的证据负担分析",
    "journal": "Nature Medicine",
    "year": 2022,
    "authors": "Dai 等",
    "article_url": "https://www.nature.com/articles/s41591-022-01978-x",
    "supplements": [
      {
        "label": "补充信息：Tables 1–11、曲线和方法",
        "url": "https://static-content.springer.com/esm/art%3A10.1038%2Fs41591-022-01978-x/MediaObjects/41591_2022_1978_MOESM1_ESM.pdf"
      },
      {
        "label": "Reporting summary",
        "url": "https://static-content.springer.com/esm/art%3A10.1038%2Fs41591-022-01978-x/MediaObjects/41591_2022_1978_MOESM2_ESM.pdf"
      }
    ],
    "code_url": "https://github.com/ihmeuw-msca/burden-of-proof",
    "summary_zh": "这项研究汇总人群观察研究，估计当前吸烟暴露与多种疾病的关联，并把研究之间的差异纳入风险的不确定性。个人报告只按已公布的暴露点查出对应人群相对风险及不确定区间，不计算个人发病概率或戒烟收益。",
    "summary_status": "draft",
    "card_notes": [
      "查表来源为正文表2；不重建连续曲线。心血管结局仅支持表中参考年龄组；星级描述证据强度，不是个人风险等级。"
    ]
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
    ],
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true,
    "targets_flag": "--targets",
    "levers_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "current_smoker",
      "label_zh": "当前吸烟状态",
      "unit": "1",
      "accept": {},
      "range": [
        0,
        1
      ],
      "aliases": [
        "目前吸烟",
        "current smoking"
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "1=当前吸烟，0=非当前吸烟；本方法仅接受1。"
    },
    {
      "key": "equivalent_smoking_years",
      "label_zh": "每天一包强度折算的累计吸烟年数",
      "unit": "a",
      "accept": {
        "year": 1
      },
      "range": [
        0,
        300
      ],
      "aliases": [
        "累计包年数",
        "包年",
        "pack-years",
        "pack years"
      ],
      "required": false,
      "from": "measurements",
      "note_zh": "这是按每天一包强度折算的年数，数值等于包年数，不是直接填写吸烟持续年数。a表示这种等效暴露的年；不从当前吸烟量推算历史暴露。"
    },
    {
      "key": "daily_cigarette_count",
      "label_zh": "每日平均吸烟支数",
      "unit": "1",
      "accept": {},
      "range": [
        0,
        200
      ],
      "aliases": [
        "每日吸烟量",
        "cigarettes per day",
        "daily cigarette count"
      ],
      "required": false,
      "from": "measurements",
      "note_zh": "固定观察窗为一天，填写这一天内的平均卷烟等效支数，1表示计数单位。不是包数、烟草克数或电子烟吸口数；不自动换算其他烟草制品。"
    },
    {
      "key": "age",
      "label_zh": "实足年龄",
      "unit": "a",
      "accept": {
        "year": 1
      },
      "range": [
        30,
        120
      ],
      "aliases": [
        "年龄",
        "age"
      ],
      "required": true,
      "from": "argument",
      "flag": "--age"
    },
    {
      "key": "sex",
      "label_zh": "论文适用的性别组",
      "required": true,
      "from": "argument",
      "flag": "--sex",
      "note_zh": "male/female 或 男/女，用于性别限定癌症的适用性核对。"
    },
    {
      "key": "outcome",
      "label_zh": "健康结局",
      "required": true,
      "from": "argument",
      "flag": "--outcome",
      "note_zh": "见 references/outcomes.md；选择一项结局。"
    }
  ],
  "outputs": [
    {
      "key": "mean_rr",
      "label_zh": "对应暴露点的人群平均相对风险",
      "unit": "1"
    },
    {
      "key": "ui_lower",
      "label_zh": "95%不确定区间下限",
      "unit": "1"
    },
    {
      "key": "ui_upper",
      "label_zh": "95%不确定区间上限",
      "unit": "1"
    },
    {
      "key": "star_rating",
      "label_zh": "该关联的论文证据星级",
      "unit": "1"
    }
  ],
  "validation": {
    "status": "reproduced",
    "examples": [
      {
        "locator": "Table 2, Lung cancer row, Pack-years columns 5, 10, 20, 40 and 85th percentile",
        "quote": "5 | 10 | 20 | 40\nLung cancer | Pack-years | 1.58 (1.19, 2.15) | 2.48 (1.40, 4.53) | 5.11 (1.84, 14.99) | 11.62 (2.49, 58.73) | 50.88 | 13.42 (2.63, 74.59)",
        "values": [
          1.58,
          1.19,
          2.15,
          2.48,
          1.4,
          4.53,
          5.11,
          1.84,
          14.99,
          11.62,
          2.49,
          58.73,
          13.42,
          2.63,
          74.59
        ],
        "tolerance": "逐项精确匹配论文保留的小数；验证查表，不声称验证完整样条模型。",
        "test": "tests/test_manifest.py::test_table2_lung_cancer"
      },
      {
        "locator": "Table 2, Type 2 diabetes, Cigarettes per day, column 20",
        "quote": "20\nType 2 diabetes | Cigarettes per day | 1.49 (1.18, 1.90)",
        "values": [
          1.49,
          1.18,
          1.9
        ],
        "tolerance": "精确匹配表2印出的两位小数。",
        "test": "tests/test_manifest.py::test_table2_diabetes"
      },
      {
        "locator": "Table 2, Ischemic heart disease(ref. age: 55–59 years), column 20",
        "quote": "20\nIschemic heart disease(ref. age: 55–59 years) | Cigarettes per day | 2.43 (1.17, 5.27)",
        "values": [
          2.43,
          1.17,
          5.27
        ],
        "tolerance": "精确匹配表2印出的两位小数；仅限参考年龄组。",
        "test": "tests/test_manifest.py::test_table2_reference_age_ihd"
      }
    ]
  },
  "data_files": [
    {
      "path": "data/table2.json",
