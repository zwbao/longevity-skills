  "inputs": [
    {
      "key": "genotype",
      "label_zh": "APOE 基因型",
      "aliases": [
        "载脂蛋白E基因型",
        "APOE genotype",
        "APOE ε genotype"
      ],
      "required": true,
      "from": "argument",
      "flag": "--genotype",
      "note_zh": "分类输入无单位或连续范围：22/23/24/33/34/44，也接受 ε3/ε4、E3/E4、APOE*34 及反向排列。需报告已确认的双等位基因型，不从原始 SNP 推断。"
    },
    {
      "key": "age",
      "label_zh": "当前年龄",
      "aliases": [
        "年龄",
        "Age"
      ],
      "required": true,
      "unit": "a",
      "range": [
        55,
        120
      ],
      "from": "argument",
      "flag": "--age",
      "note_zh": "岁；实际严格大于55。120是输入质量上限而非论文最大年龄；HR模式保守限制为未满90岁。只核查范围，不按当前年龄校准。"
    },
    {
      "key": "sex",
      "label_zh": "研究性别分层",
      "aliases": [
        "Sex",
        "性别"
      ],
      "required": true,
      "from": "argument",
      "flag": "--sex",
      "note_zh": "分类输入：male/female/pooled。pooled明确请求男女合并，不能把缺失性别默认为女性或男性。祖源与东亚模式仅pooled。"
    },
    {
      "key": "analysis",
      "label_zh": "分析类型",
      "aliases": [
        "Analysis"
      ],
      "required": false,
      "from": "argument",
      "flag": "--analysis",
      "note_zh": "case-control（默认）查询OR；survival查询HR；ancestry查询祖源超过75%分组OR。"
    },
    {
      "key": "group",
      "label_zh": "研究种族／族裔分组",
      "aliases": [
        "Race and ethnicity",
        "人群分组"
      ],
      "required": false,
      "from": "argument",
      "flag": "--group",
      "note_zh": "case-control/survival模式条件必填：nhw/nhb/hispanic/east_asian。east_asian仅日、韩汇总OR。不能从姓名、语言、国籍或祖源比例自动推断。"
    },
    {
      "key": "ancestry",
      "label_zh": "全基因组祖源类型",
      "aliases": [
        "Global population ancestry",
        "遗传祖源"
      ],
      "required": false,
      "from": "argument",
      "flag": "--ancestry",
      "note_zh": "ancestry模式条件必填：european/african/amerindian，必须有全基因组祖源估计；不是APOE局部祖源。"
    },
    {
      "key": "ancestry_percent",
      "label_zh": "全基因组祖源比例",
      "aliases": [
        "Global ancestry proportion",
        "Ancestry percentage",
        "全基因组祖源百分比"
      ],
      "required": false,
      "unit": "%",
      "range": [
        0,
        100
      ],
      "unit_required": true,
      "from": "measurements",
      "note_zh": "ancestry模式条件必填：所选祖源的百分比，必须严格超过75%；不支持以种族代替报告。只接受百分数，不猜测0到1比例。"
    }
  ],
