      "unit": "1",
      "accept": {},
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "医生曾告知充血性心力衰竭。 1=是，0=否；未知须补问，不得填0。"
    },
