  "validation": {
    "status": "reproduced",
    "examples": [
      {
        "locator": "JAMA 2006;295(7):801, Comment, colorectal cancer screening example; Table 3 points and Table 4 validation row ≥14",
        "quote": "For example, a 75-year-old male smoker with heart failure, difficulty bathing, walking, and managing finances ... his probability of 4-year mortality is greater than 64% (16 points)",
        "values": [
          75,
          64,
          16
        ],
        "tolerance": "整数分精确相等；BMI未印出，印出总分16意味着BMI<25项不计分，测试用BMI 28；未列项目按示例视为无。",
        "test": "tests/test_manifest.py::test_printed_comment_16_point_example"
