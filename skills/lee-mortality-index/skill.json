{
  "schema": "longevity-skill/1",
  "name": "lee-mortality-index",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "cohort",
  "domains": [
    "衰弱与死亡风险"
  ],
  "topic": [
    "musculoskeletal_frailty"
  ],
  "blurb_zh": "用年龄、病史和日常功能问卷计算Lee四年死亡风险指数。",
  "intents": [
    "frailty_mortality"
  ],
  "triage": {
    "reason_zh": "人体社区队列公开逐项计分与逐分死亡率，可计算个人分层；正文Comment的16分示例已复现。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1001/jama.295.7.801",
    "title": "Development and validation of a prognostic index for 4-year mortality in older adults.",
    "title_zh": "老年人四年死亡风险预后指数的开发与验证",
    "journal": "JAMA",
    "year": 2006,
    "authors": "Lee 等",
    "article_url": "https://jamanetwork.com/journals/jama/fullarticle/202375",
    "supplements": [],
    "card_notes": [
      "采用正文表3计分和表4验证队列逐分死亡率；期刊全文页未列单独补充表或发布代码。",
      "勘误明确糖尿病为1分：https://jamanetwork.com/journals/jama/fullarticle/202729 。",
      "正文Comment的75岁男性16分示例已复现；Results中78岁示例的年龄分值与表3不一致，以表3为准。"
    ],
    "summary_zh": "这项研究发现，美国社区居住中老年人的年龄、性别、自报病史和日常功能可共同用于死亡风险分层。个人报告只计算问卷总分并查出相应的历史队列死亡率，不推算个人能活多久或治疗收益。",
    "summary_status": "draft"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
    ],
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true,
    "targets_flag": "--targets",
    "levers_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "bmi_kg_m2",
      "label_zh": "体质指数",
      "aliases": [
        "BMI",
        "body mass index",
        "体重指数"
      ],
      "unit": "kg/m^2",
      "accept": {
        "kg/m2": 1
      },
      "range": [
        10,
        80
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "使用本人身高体重计算的BMI；低于25加分不是增重建议。"
    },
    {
      "key": "community_dwelling",
      "label_zh": "社区居住",
      "aliases": [
