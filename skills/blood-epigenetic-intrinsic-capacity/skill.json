{
  "schema": "longevity-skill/1",
  "name": "blood-epigenetic-intrinsic-capacity",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "cohort",
  "domains": [
    "甲基化"
  ],
  "blurb_zh": "血液甲基化芯片的 91 个位点 β 值，按论文补充表 1 算甲基化内在能力（认知、行走、情绪、感官和活力的综合）。",
  "intents": [
    "epigenetic_age",
    "frailty_mortality"
  ],
  "triage": {
    "reason_zh": "91个CpG的β值按补充表1的弹性网系数和截距算出个人甲基化内在能力分数。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1038/s43587-025-00883-5",
    "title": "A blood-based epigenetic clock for intrinsic capacity predicts mortality and is associated with clinical, immunological and lifestyle factors",
    "title_zh": "基于血液的内在能力表观遗传时钟可预测死亡，并与临床、免疫和生活方式因素相关",
    "journal": "Nature Aging",
    "year": 2025,
    "authors": "Fuentealba 等",
    "article_url": "https://doi.org/10.1038/s43587-025-00883-5",
    "supplements": [
      {
        "label": "补充表 1–8（含 91 个位点系数和截距）",
        "url": "https://static-content.springer.com/esm/art%3A10.1038%2Fs43587-025-00883-5/MediaObjects/43587_2025_883_MOESM2_ESM.xlsx"
      }
    ],
    "summary_zh": "这项研究以认知、行动、心理、感官和活力五方面的临床评估衡量人的内在能力，用血液DNA甲基化建成预测它的时钟，并在弗雷明汉心脏研究中发现它预测全因死亡强于前两代表观遗传时钟。个人报告只在91个甲基化位点的β值交齐时，按补充表1的系数和截距算甲基化内在能力，不做死亡预测。",
    "summary_status": "draft"
  },
