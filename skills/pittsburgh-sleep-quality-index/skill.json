    "human"
  ],
  "evidence": "method",
  "domains": [
    "睡眠与昼夜节律"
  ],
  "topic": [
    "sleep_circadian"
  ],
  "blurb_zh": "用过去一个月的睡眠问卷回答计算PSQI七个分量、总分与睡眠质量筛查分组。",
  "intents": [
    "wearable_sleep"
  ],
  "triage": {
    "reason_zh": "原始人体量表研究的附录印出七分量及0–21分合计规则和大于5分切点，可提供个人睡眠质量读出；原文歧义输入不自动计分。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1016/0165-1781(89)90047-4",
    "title": "The Pittsburgh Sleep Quality Index: a new instrument for psychiatric practice and research.",
    "title_zh": "匹兹堡睡眠质量指数：精神科实践和研究的新工具",
    "journal": "Psychiatry research",
    "year": 1989,
    "authors": "Buysse 等",
    "article_url": "https://doi.org/10.1016/0165-1781(89)90047-4",
    "supplements": [
      {
        "label": "原论文及文内计分附录（pp.211–213）",
        "url": "https://www.psychiatry.pitt.edu/sites/default/files/inline-files/PSQI%20Article.pdf"
      }
    ],
    "card_notes": [
      "采用1989年原版完整回答计分；恰好6小时等印刷歧义输入停止计分，不补猜规则。",
      "已核对官方现行说明，未采用2005年的Q5j缺失置零修改；官网列出的Access计分数据库未能取得。",
      "验证复现附录逐项映射；不代表重新验证诊断准确度。"
    ],
    "summary_zh": "这项研究在人类健康对照、抑郁患者和睡眠障碍患者中发现，自评睡眠问卷能够区分睡眠质量不同的人群。个人报告只计算过去一个月的睡眠质量分量、总分及筛查分组，不估计生物年龄、寿命或疾病概率。",
    "summary_status": "draft"
  },
