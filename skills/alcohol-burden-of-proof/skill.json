  "blurb_zh": "用自己的每日平均纯酒精摄入量，查阅论文中各疾病相对于无饮酒的风险比及不确定性区间；不推算个人患病概率。",
  "intents": [
    "intervention_evidence"
  ],
  "triage": {
    "reason_zh": "正文表 3 按每日纯酒精摄入量列出各结局的相对风险及区间，可直接将个人摄入量对应到印出的节点。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1038/s44360-026-00139-5",
    "title": "Health effects associated with alcohol consumption: a Burden of Proof study.",
    "title_zh": "酒精摄入相关健康效应：证据负担研究",
    "journal": "Nature Health",
    "year": 2026,
    "authors": "Dai 等",
