{
  "schema": "longevity-skill/1",
  "name": "pyaging",
  "kind": "tool",
  "tier": "tool",
  "species": [
    "human",
    "multi_species"
  ],
  "evidence": "method",
  "domains": [
    "工具与证据库"
  ],
  "blurb_zh": "pyaging 0.5.2（lucascamillomd/pyaging edb1b37）。在用户提供的特征矩阵上运行衰老时钟。",
  "intents": [
    "epigenetic_age"
  ],
  "tool": {
    "upstream": "https://github.com/lucascamillomd/pyaging",
    "version": "0.5.2",
    "commit": "edb1b37",
    "requires": [
      "pyaging"
    ],
    "doi": "10.1093/bioinformatics/btae200"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "runtime": "pyaging",
    "age_flag": "--age",
    "out_flag": "--out",
    "result_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "matrix",
      "label_zh": "特征矩阵（第一列样本名，其余列是探针、基因或血液化学项目）",
      "required": true,
      "from": "argument",
      "flag": "--matrix",
      "note_zh": "甲基化时钟要 0 到 1 的 β 值矩阵。IDAT 要先预处理。"
    },
    {
      "key": "clocks",
      "label_zh": "要跑的时钟名（逗号分隔，默认 horvath2013）",
      "required": false,
      "from": "argument",
      "flag": "--clocks"
    },
    {
      "key": "age",
      "label_zh": "实足年龄",
      "unit": "a",
      "range": [
        0,
        120
      ],
      "required": false,
      "from": "profile",
      "flag": "--age"
    }
  ],
  "outputs": [
    {
      "key": "dnam_horvath2013",
      "label_zh": "Horvath 甲基化年龄",
      "unit": "a"
    },
    {
      "key": "dnam_hannum",
      "label_zh": "Hannum 甲基化年龄",
      "unit": "a"
    },
    {
      "key": "dnam_phenoage",
      "label_zh": "甲基化表型年龄（DNAm PhenoAge，不是血检表型年龄）",
      "unit": "a"
    },
    {
      "key": "dnam_grimage2",
      "label_zh": "GrimAge2 甲基化年龄",
      "unit": "a"
    },
    {
      "key": "dnam_altumage",
      "label_zh": "AltumAge 甲基化年龄",
      "unit": "a"
    },
    {
      "key": "dnam_dunedinpace",
      "label_zh": "DunedinPACE 衰老速度",
      "unit": "1"
    }
  ]
}
