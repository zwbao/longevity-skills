      "required": false,
      "from": "argument",
      "flag": "--drinking-status",
      "note_zh": "current/former/lifetime_abstainer。正值默认current；零摄入必须明确former（既往饮酒、现已完全不饮酒）或lifetime_abstainer（终身未饮酒）。不是可调整目标。"
    },
    {
      "key": "sex",
      "label_zh": "性别",
      "required": false,
      "from": "profile",
      "flag": "--sex",
      "note_zh": "male/female使用表4同性别参照；省略时用表2总体，不猜测性别。"
    },
    {
      "key": "age",
      "label_zh": "年龄",
      "unit": "a",
      "range": [
        18,
        120
      ],
      "required": false,
      "from": "profile",
      "flag": "--age",
      "note_zh": "仅作成人使用范围检查，18–120为工具限制，不是论文人群年龄界限。个人年龄不参与查表。"
    }
  ],
  "outputs": [
