  "triage": {
    "reason_zh": "人体研究正文表4印出按性别和年龄分组的全部体能切点，能用个人标准化测量比较，并复现正文实例。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1093/geront/gns071",
    "title": "Development and validation of criterion-referenced clinically relevant fitness standards for maintaining physical independence in later years.",
