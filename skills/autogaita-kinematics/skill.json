    "before_after"
  ],
  "triage": {
    "reason_zh": "人体步态坐标可按公开算法计算个人角度、水平速度和实测跨步距离；不需要回归模型参数，不估计推进力或衰老风险。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1073/pnas.2534093123",
    "title": "Cross-species identification of conserved and divergent locomotor kinematic strategies using AutoGaitA.",
    "title_zh": "跨物种步态运动学的保守与差异策略",
    "journal": "Proceedings of the National Academy of Sciences of the United States of America",
    "year": 2026,
    "authors": "Hosseini 等",
