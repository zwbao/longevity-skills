    "frailty_mortality",
    "body_fat_waist"
  ],
  "triage": {
    "reason_zh": "正文表 2 完整印出 BMI 九档切点、HR 和置信区间，可用个人身高体重离线查表。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1016/s0140-6736(16)30175-1",
    "title": "Body-mass index and all-cause mortality: individual-participant-data meta-analysis of 239 prospective studies in four continents.",
    "title_zh": "体质指数与全因死亡：四大洲前瞻性研究的个体数据荟萃分析",
    "journal": "Lancet (London, England)",
    "year": 2016,
    "authors": "Di Angelantonio 等",
    "article_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4995441/",
    "supplements": [
      {
        "label": "Supplementary appendix（eTable 8、eAppendix 2）",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/instance/4995441/bin/mmc1.pdf"
      }
    ],
    "card_notes": [
      "论文署名为 The Global BMI Mortality Collaboration；此处采用写作委员会第一作者简称。",
      "使用正文表 2 的九档合并关联；附录已核对，非六档 WHO 结果。未发现公开发布的分析代码链接。"
    ],
    "summary_zh": "这项研究汇总多地区人群前瞻性队列，发现从不吸烟且无相关既往慢病的人群中，偏低及偏高的体质指数与较高全因死亡危险有关。个人报告只计算体质指数并查询对应分档的人群关联，不计算个人死亡概率或预期寿命。",
    "summary_status": "draft"
  },
