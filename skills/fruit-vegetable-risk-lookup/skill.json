{
  "schema": "longevity-skill/1",
  "name": "fruit-vegetable-risk-lookup",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "review",
  "domains": [
    "营养与代谢"
  ],
  "blurb_zh": "用日均果蔬摄入量查出论文中的人群相对风险及相邻表格行。",
  "intents": [
    "frailty_mortality",
    "intervention_evidence"
  ],
  "triage": {
    "reason_zh": "人体前瞻性研究的荟萃分析在补充表8至18印出摄入克数与风险比，可用个人摄入量直接查表，已复现印出行。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1093/ije/dyw319",
    "title": "Fruit and vegetable intake and the risk of cardiovascular disease, total cancer and all-cause mortality-a systematic review and dose-response meta-analysis of prospective studies.",
    "title_zh": "果蔬摄入量与心血管疾病、总癌症及全因死亡风险",
    "journal": "International Journal of Epidemiology",
    "year": 2017,
    "authors": "Aune 等",
    "article_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837313/",
    "supplements": [
      {
        "label": "补充表8–18（PDF）",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/instance/5837313/bin/supplementary_materials_dyw319.pdf"
      },
      {
        "label": "Webappendix（MOOSE清单）",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/instance/5837313/bin/supplementary_webappendix_dyw319.docx"
      }
    ],
    "summary_zh": "这项研究汇总人群前瞻性研究，发现较高的水果和蔬菜摄入量与较低的心血管疾病、总癌症及全因死亡风险相关。个人报告只按日均摄入量查出论文印出的相对风险和相邻表格行，不计算个人患病概率或预期寿命。",
    "summary_status": "draft",
    "card_notes": [
      "采用补充表8–18的限制性立方样条结果数值；保留每列不同的参照摄入量与发病、死亡或合并结局。",
      "未印出的摄入点只显示相邻行；空白保留缺失，超出各列表格范围不外推。",
      "原文与补充材料未链接作者代码仓库；不重拟合样条。"
    ]
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
    ],
    "out_flag": "--out",
    "result_json": true,
    "targets_flag": "--targets",
    "levers_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "intake_g_d",
      "label_zh": "日均摄入量",
      "aliases": [
        "摄入量",
        "平均每日摄入量",
        "daily intake",
        "intake",
        "g/d intake"
      ],
      "unit": "g/d",
      "accept": {
        "g/d": 1
      },
      "range": [
        0,
        3000
      ],
      "unit_required": true,
      "required": true,
      "from": "measurements",
      "note_zh": "所选食物组的长期日均克数，不是营养素浓度。仅接受 g/d；份、杯和盘的大小不统一。0–3000是录入检查范围，各表可查范围另行判断。"
    },
    {
      "key": "food_group",
      "label_zh": "食物组",
      "required": false,
      "from": "argument",
      "flag": "--food-group",
      "note_zh": "combined（默认，水果与蔬菜合计）、fruit 或 vegetables。测量和目标必须对应同一组。"
    },
    {
      "key": "outcome",
      "label_zh": "结局",
      "required": false,
      "from": "argument",
      "flag": "--outcome",
      "note_zh": "默认 all_cause_mortality；另支持 coronary_heart_disease、stroke、ischemic_stroke、hemorrhagic_stroke、cardiovascular_disease、total_cancer。"
    },
    {
      "key": "endpoint",
      "label_zh": "分析类型",
      "required": false,
      "from": "argument",
      "flag": "--endpoint",
      "note_zh": "mixed、incidence、mortality；未指定时全因死亡用mortality，其余用mixed。卒中亚型仅支持mixed。"
    }
  ],
  "outputs": [
    {
      "key": "food_group",
      "label_zh": "食物组"
    },
    {
      "key": "outcome",
      "label_zh": "结局"
    },
    {
      "key": "endpoint",
      "label_zh": "分析类型"
    },
    {
      "key": "intake_g_d",
      "label_zh": "输入日均摄入量",
      "unit": "g/d"
    },
    {
      "key": "status",
      "label_zh": "查表状态",
      "note_zh": "exact=命中印出行；bracket=仅列相邻两行；outside_table=超出该列范围；not_published=该列无数值。"
    },
    {
      "key": "reference_g_d",
