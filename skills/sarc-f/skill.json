  "evidence": "cohort",
  "topic": [
    "musculoskeletal_frailty",
    "screening_prevention"
  ],
  "domains": [
    "肌少症与身体功能"
  ],
  "blurb_zh": "用提物、走路、起身、爬楼和跌倒问卷计算SARC-F肌少症风险筛查分数。",
  "intents": [
    "frailty_mortality"
  ],
  "triage": {
    "reason_zh": "人体研究公开五项计分与总分阈值，可重算个人SARC-F；已复现方法段印出的跌倒逐项分值。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1002/jcsm.12048",
    "title": "SARC-F: a symptom score to predict persons with sarcopenia at risk for poor functional outcomes.",
    "title_zh": "SARC-F：识别肌少症相关不良功能结局风险的症状评分",
    "journal": "Journal of Cachexia, Sarcopenia and Muscle",
    "year": 2016,
    "authors": "Malmstrom 等",
    "article_url": "https://onlinelibrary.wiley.com/doi/10.1002/jcsm.12048",
    "supplements": [],
    "card_notes": [
      "采用正文方法段的AAH/BLSA标准问卷；NHANES的跌倒近似编码未用于本技能。",
      "出版社全文与Europe PMC全文XML未列独立补充文件或发布代码；复现对象为原文逐项分值，并非个体结局概率。"
    ],
    "summary_zh": "这项研究在美国社区中老年人中发现，自报肌力、活动困难和跌倒情况组成的症状评分与身体功能及后续不良结局有关。个人报告只计算问卷各项分数、总分和筛查分层，不推算个人死亡概率、寿命或治疗收益。",
    "summary_status": "draft"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
    ],
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "strength_score",
      "label_zh": "提举重物困难程度",
      "aliases": [
        "Strength",
        "力量",
        "提举重物"
      ],
      "unit": "1",
      "accept": {},
      "range": [
        0,
        2
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "提举或搬运10磅物品：0=无困难，1=有些困难，2=很困难或无法完成。 只填整数；未知须补问，不得当作0。"
    },
    {
      "key": "walking_score",
      "label_zh": "室内步行困难程度",
      "aliases": [
