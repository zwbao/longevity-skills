{
  "schema": "longevity-skill/1",
  "name": "frail-scale",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "cohort",
  "domains": [
    "衰弱与功能"
  ],
  "topic": [
    "musculoskeletal_frailty"
  ],
  "blurb_zh": "用疲劳、上楼和步行困难、疾病种数及一年体重变化计算FRAIL衰弱筛查分数。",
  "intents": [
    "frailty_mortality"
  ],
  "triage": {
    "reason_zh": "人体社区队列验证，正文与附录印出FRAIL五项计分和分层切点，可用个人问卷及体重计算。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.1007/s12603-012-0084-2",
    "title": "A simple frailty questionnaire (FRAIL) predicts outcomes in middle aged African Americans.",
    "title_zh": "FRAIL简易衰弱问卷的社区人群验证",
    "journal": "The journal of nutrition, health & aging",
    "year": 2012,
    "authors": "Morley 等",
    "article_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4515112/",
    "supplements": [
      {
        "label": "文内附录1：AAH问卷及计分",
        "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4515112/#APP1"
      }
    ],
    "card_notes": [
      "采用本文AAH版本；附录为文内材料，未见独立补充文件或研究代码链接。",
      "体重下降恰好5%时按正文计1分；附录只写大于及小于5%，未覆盖等号。",
      "验证复现的是附录印出的疾病种数与单项得分，未声称复现个人死亡预测。"
    ],
    "summary_zh": "这项研究在美国社区中晚年非裔成年人中发现，简易衰弱问卷的分层与后续功能下降和死亡有关。个人报告只计算问卷各项得分、总分及衰弱筛查分层，不估计个人死亡概率或预期寿命。",
    "summary_status": "draft"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "measurements_flag": "--measurements",
    "measurements_header": [
      "marker",
      "value",
      "unit"
    ],
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true
  },
  "population": {
    "age_years": [
      49,
      65
    ],
    "note_zh": "美国圣路易斯社区非裔成年人；两个按基线ADL状态排除的重叠分析样本，不能视为两个独立验证队列。"
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "fatigue_response_code",
      "label_zh": "过去四周疲劳频度编码",
      "aliases": [
        "疲劳频度",
        "Fatigue response",
        "Fatigue"
      ],
      "unit": "score",
      "range": [
        1,
        5
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "过去4周感到疲劳的时间：1一直，2大部分，3有些时候，4少部分，5从不；填原回答编码，不能填已折算的0/1分。"
    },
    {
      "key": "resistance_difficulty_binary",
      "label_zh": "独自连续上十级台阶有困难",
      "aliases": [
        "上楼困难",
        "Resistance",
        "Difficulty walking up 10 steps"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "独自、不用辅助器具、不休息走上10级台阶是否有任何困难：1是，0否。"
    },
    {
      "key": "ambulation_difficulty_binary",
      "label_zh": "独自步行数百码有困难",
      "aliases": [
        "步行困难",
        "Ambulation",
        "Difficulty walking several hundred yards"
      ],
      "unit": "1",
      "range": [
        0,
        1
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "独自、不用辅助器具步行数百码是否有任何困难：1是，0否；保留本研究题干，不替换成一个街区。"
    },
    {
      "key": "illnesses_count",
      "label_zh": "医生告知的指定疾病种数",
      "aliases": [
        "疾病种数",
        "Illnesses",
        "Illness count"
      ],
      "unit": "1",
      "range": [
        0,
        11
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "只数11类：高血压、糖尿病、癌症（不含轻微皮肤癌）、慢性肺病、心肌梗死、充血性心力衰竭、心绞痛、哮喘、关节炎、卒中、肾病；每类最多一次。"
    },
    {
      "key": "weight_current_kg",
      "label_zh": "当前体重",
      "aliases": [
        "现在体重",
        "Current weight"
      ],
      "unit": "kg",
      "range": [
        15,
        500
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "穿衣、不穿鞋的当前体重。15–500 kg是输入错误防护范围，不是论文的临床切点。",
      "accept": {
        "lb": 0.45359237,
        "g": 0.001
      },
      "unit_required": true
    },
    {
      "key": "weight_year_ago_kg",
      "label_zh": "一年前体重",
      "aliases": [
        "去年体重",
        "Weight 1 year ago"
      ],
      "unit": "kg",
      "range": [
        15,
        500
      ],
      "required": true,
      "from": "measurements",
      "note_zh": "一年前穿衣、不穿鞋的体重，不能用半年前体重代替；不知道则保持缺失。",
      "accept": {
        "lb": 0.45359237,
        "g": 0.001
      },
      "unit_required": true
    },
    {
      "key": "age",
      "label_zh": "实足年龄",
      "unit": "a",
      "range": [
        18,
        120
      ],
      "required": false,
      "from": "profile",
      "flag": "--age",
      "note_zh": "仅用于提示是否超出研究49–65岁基线范围，不改变分数。"
    },
    {
      "key": "sex",
      "label_zh": "性别",
      "required": false,
      "from": "profile",
      "flag": "--sex",
      "note_zh": "可选上下文，不进入评分；男/女/其他/未知或male/female/other/unknown。"
    }
  ],
  "outputs": [
